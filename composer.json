{
  "name": "wexample/symfony-remote",
  "description": "Registry, health checks and configuration of the external services a Symfony app talks to",
  "type": "library",
  "license": "MIT",
  "version": "2.0.10",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyRemote\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyRemote\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "symfony/rate-limiter": "^7.4",
    "wexample/php-api": ">=5.0.6",
    "wexample/php-remote": ">=2.0.1",
    "wexample/symfony-helpers": ">=18.0.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^13",
    "wexample/symfony-testing": ">=1.0.86"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}